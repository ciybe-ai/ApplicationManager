<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ApplicationManager.SystemAgent</RootNamespace>
    <AssemblyName>ApplicationManager.SystemAgent</AssemblyName>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Framework-dependent statt self-contained: die EXE enthaelt nur noch
         den eigenen Code, nicht die komplette .NET-Runtime (~64 MB -> wenige MB).
         Voraussetzung: .NET 8 Runtime muss auf dem Ziel-PC installiert sein -
         Install.ps1 kuemmert sich automatisch darum (winget), siehe scripts/Install.ps1. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\ApplicationManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
